# Reference: https://github.com/Homebrew/homebrew-bundle
#
# ============================ BASE ============================
# Everything from here down to the OVERLAY marker is the base set: packages that
# belong on ANY Mac. At Phase 3 of the chezmoi migration this becomes
# dot_config/homebrew/Brewfile, applied on every machine.
# See runbooks/chezmoi-migration-plan.md (D3, Phase 0.5).
# ==============================================================

# A better Terminal
cask "ghostty"

# Prerequisite, but good to just make sure its there
brew "git"
brew "git-filter-repo" # extension used for things like removing large files from history

# Prefered credential manager on macOS for GitHub
# NOTE: Re-enabled 2026-08-06. The earlier "installation is failing" note was stale —
# GCM 2.9.1 is installed and working. Its .pkg installs to /usr/local/share/gcm-core
# even on Apple Silicon, which is why git/gitconfig points there rather than at
# /opt/homebrew. Do not "fix" that path.
cask "git-credential-manager"

# Open and/or free fonts
cask "font-fira-code"
cask "font-monaspace" # https://monaspace.githubnext.com/

# Dotfiles tooling
# chezmoi manages this repo; antidote is the zsh plugin manager (replaces the
# zsh/antidote git submodule). Activate antidote with:
#   source $HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh
brew "chezmoi"
brew "antidote"

# Replacement for cat and man, supporting colorized syntax highlighting
brew "bat"
tap "eth-p/software"
# NOTE: non-official taps must be trusted before Homebrew will load them or check
# whether they are outdated. Trust is per-MACHINE (~/.homebrew/trust.json) and is
# deliberately NOT managed by this repo, so each new Mac needs this run by hand:
#   brew trust --formula eth-p/software/bat-extras-batman
# Trusted on czimacos6457 on 2026-08-06. Note `alias man='batman'` in zshrc depends
# on this formula, so an untrusted machine has a broken `man`.
brew "eth-p/software/bat-extras-batman"

# jq - macOS has this built in, but managing it through brew would allow for updating easier
brew "jq"

# Disk usage visualization utility
brew "ncdu"

# Modern web server, but mostly just used for static file serving
# https://caddyserver.com/docs/command-line
brew "caddy"

# Modern Python - symlinks for python3 and pip3 will invoke this version
# https://docs.brew.sh/Homebrew-and-Python
brew "python@3.12"

# fzf - Fuzzy Finder
brew "fzf"
brew "tree" # used to preview directories, and a generally useful utility

# 1Password CLI
tap "1Password/tap"
  cask "1password-cli"

# fnm - Fast Node Manager (replacement for nvm)
brew "fnm"

# Deno
brew "deno"

# Rust
brew "rustup"

# Go (golang)
# We can use the go@{version} notation if we care about a fixed version.
brew "go"

# Swift open source toolchain manager
brew "swiftly"

# Screen recording
cask "kap"

# AI
cask "claude-code"
brew "anomalyco/tap/opencode"

# ================= PERSONAL (role = personal) ==================
# Wanted only on the personal Mac, which does not exist yet — it gets set up
# after the work-Mac migration completes.
#
# These are currently INSTALLED on this work Mac and were previously in the base
# set. They stay in this file for now, so the current dotbot setup keeps behaving
# identically and nothing gets uninstalled. `brew bundle install` never removes
# packages, so leaving them here is harmless.
#
# OPEN QUESTION for Phase 3 — where does this block actually go? D3 only defines
# two layers (base + per-machine overlay), and there is no slot for "every
# personal machine". Either:
#   a) add a role layer, applying base -> Brewfile.{{ .role }} -> Brewfile.{{ .machine }}
#   b) park these in the future personal machine's overlay instead
# Resolve before Phase 3. See runbooks/chezmoi-migration-plan.md (R3).
# ===============================================================

# Exiftool - used by digiKam and RawTherapee (photography workflow)
brew "exiftool"

# Media tools
brew "ffmpeg" # dependency for merging fragments and tracks
brew "bento4" # package that contains mp4decrypt
brew "yt-dlp" # fork of Youtube-DL with more features and built on modern Python
# MakeMVK is used to convert ripped DVD images and discs into MKV files without transcoding the media
cask "makemkv"

# Keyboard and mouse sharing
# NOTE: deskflow is a server/client app — both ends of a shared keyboard/mouse
# setup need it installed. If the intent is to share between this work Mac and the
# personal Mac, this belongs in BASE, not here. Flagged for confirmation.
tap "deskflow/tap"
  cask "deskflow/tap/deskflow"

