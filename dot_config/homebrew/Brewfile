# Reference: https://github.com/Homebrew/homebrew-bundle
#
# ============================ BASE ============================
# The base layer: packages that belong on ANY Mac.
#
# D3 defines three layers, applied in order. Source paths here; they deploy to the
# matching ~/.config/homebrew/ targets.
#   1. dot_config/homebrew/Brewfile                    <- this file, every machine
#   2. dot_config/homebrew/Brewfile.role-<role>        <- every machine of that role
#   3. dot_config/homebrew/Brewfile.machine-<machine>  <- one specific machine
#
# .chezmoiignore filters the role/machine layers so only the ones matching this
# machine are ever written. The Phase 4 script applies whichever layers exist,
# stat-guarding each, and must NOT run `brew trust` (D8).
#
# See runbooks/chezmoi-migration-plan.md (D3, R3, Phase 0.5).
# ==============================================================

# A better Terminal
cask "ghostty"

# Prerequisite, but good to just make sure its there
brew "git"
brew "git-filter-repo" # extension used for things like removing large files from history

# Prefered credential manager on macOS for GitHub
# NOTE: Re-enabled 2026-08-06. The earlier "installation is failing" note was stale —
# GCM 2.9.1 is installed and working. Its .pkg installs to /usr/local/share/gcm-core
# even on Apple Silicon, which is why git/gitconfig points there rather than at
# /opt/homebrew. Do not "fix" that path.
cask "git-credential-manager"

# Open and/or free fonts
cask "font-fira-code"
cask "font-monaspace" # https://monaspace.githubnext.com/

# Dotfiles tooling
# chezmoi manages this repo; antidote is the zsh plugin manager (replaces the
# zsh/antidote git submodule). Activate antidote with:
#   source $HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh
brew "chezmoi"
brew "antidote"
# Secret scanning. Used by .githooks/pre-commit as the broader second layer over
# that hook's own built-in patterns (P5-3).
brew "gitleaks"

# Password generator
brew "pwgen"

# Replacement for cat and man, supporting colorized syntax highlighting
brew "bat"
tap "eth-p/software"
# NOTE: non-official taps must be trusted before Homebrew will load them or check
# whether they are outdated. Trust is per-MACHINE (~/.homebrew/trust.json) and is
# deliberately NOT managed by this repo, so each new Mac needs this run by hand:
#   brew trust --formula eth-p/software/bat-extras-batman
# Trusted on czimacos6457 on 2026-08-06. Note `alias man='batman'` in zshrc depends
# on this formula, so an untrusted machine has a broken `man`.
brew "eth-p/software/bat-extras-batman"

# Create and run Linux containers using lightweight virtual machines
brew "container"
# Generic machine emulator and virtualizer
brew "qemu"

# jq - macOS has this built in, but managing it through brew would allow for updating easier
brew "jq"

# Disk usage visualization utility
brew "ncdu"

# Modern web server, but mostly just used for static file serving
# https://caddyserver.com/docs/command-line
brew "caddy"

# Modern Python. NOTE: `python3` on PATH is not necessarily this version — other
# formulae pull in newer Pythons as dependencies. Check with `python3 --version`.
# https://docs.brew.sh/Homebrew-and-Python
brew "python@3"
# Extremely fast Python package installer and resolver, written in Rust
brew "uv"

# fzf - Fuzzy Finder
brew "fzf"
brew "tree" # used to preview directories, and a generally useful utility
# Show ps output as a tree
brew "pstree"

# Fast recursive search. Also a runtime dependency of opencode, but declared
# directly so Homebrew cleanup cannot misclassify it while anomalyco/tap is untrusted.
brew "ripgrep"

# 1Password CLI
# Fully qualified on purpose (D8). An untrusted tap is not *loaded*, so a bare
# `cask "1password-cli"` cannot be resolved on a machine that has not run
# `brew trust --cask 1password/tap/1password-cli`; the qualified form installs
# anyway and only loses its outdatedness check. This one matters more than the
# rest: private_secrets.zsh.tmpl calls onepasswordRead, so a work machine with no
# `op` fails the whole apply. Trusted on czimacos6457 on 2026-08-07.
tap "1Password/tap"
  cask "1password/tap/1password-cli"

# fnm - Fast Node Manager (replacement for nvm)
brew "fnm"

# Deno
brew "deno"

# Rust
brew "rustup"

# Go (golang)
# We can use the go@{version} notation if we care about a fixed version.
brew "go"

# Swift open source toolchain manager
brew "swiftly"

# Screen recording
cask "kap"

# AI
cask "claude-code"
brew "anomalyco/tap/opencode"
brew "summarize"
