# Reference: https://github.com/Homebrew/homebrew-bundle
#
# ROLE LAYER: personal
#
# Applied on every machine whose role is "personal" (D3, three-layer model:
# base -> role -> machine). See runbooks/chezmoi-migration-plan.md.
#
# These packages were moved off the work Mac czimacos6457 on 2026-08-06 and
# belong on personal machines such as iris.
#
# Deploys to ~/.config/homebrew/Brewfile.role-personal, but only on machines whose
# role is "personal" — .chezmoiignore filters out every non-matching role layer.

# Exiftool - used by digiKam and RawTherapee (photography workflow)
brew "exiftool"

# Media tools
brew "ffmpeg" # dependency for merging fragments and tracks
brew "bento4" # package that contains mp4decrypt
brew "yt-dlp" # fork of Youtube-DL with more features and built on modern Python
cask "mediainfo"
cask "spatial"

# MakeMKV remains installed manually for decrypting DVD and Blu-ray discs;
# MKVToolNix does not replace that capability. MakeMKV's Homebrew cask is deprecated,
# so it is deliberately not declared in this Brewfile.
cask "mkvtoolnix-app"

# Keyboard and mouse sharing
# DECIDED 2026-08-06: personal role only. deskflow is a server/client app, so
# sharing input between two machines would need it on both ends — that is
# explicitly not wanted right now, and it stays off every non-personal machine.
# Uninstalled from czimacos6457. If this is ever revisited, moving these two lines
# to the base Brewfile is the whole change.
tap "deskflow/tap"
  cask "deskflow/tap/deskflow"

# AI
# Multi-modal AI summarizer.
brew "summarize"
