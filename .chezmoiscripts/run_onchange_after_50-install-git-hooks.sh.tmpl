#!/usr/bin/env bash
#
# Point this repo's git at the tracked .githooks/ directory.
#
# The pre-commit hook there blocks commits that look like they contain a credential
# (P5-3). Hooks in .git/hooks are not version controlled and would be lost on every
# fresh clone, so the hooks live in .githooks/ — which IS tracked — and core.hooksPath
# points at them. That setting is per-repository and local, so it affects only this
# repo and never leaks into others.
#
# On the prefix, which took three tries to get right:
#
#   run_once_    WRONG. Recorded by content hash in a state database that outlives the
#                source directory. At cutover the source moves from ~/Developer/dotfiles
#                to ~/.local/share/chezmoi (D5, P8-4) and the script is already marked
#                done — leaving the NEW clone with no hook and no warning.
#   run_         WRONG. Runs every apply, so it is permanently listed as pending by
#                `chezmoi status`, which makes `chezmoi verify` exit non-zero forever
#                and destroys its value as a drift detector.
#   run_onchange_ RIGHT, because of the `repo=` line below. The rendered content embeds
#                the source directory path, so moving the source changes the content and
#                re-fires the script — covering the cutover case without the run_ tax.
set -euo pipefail

repo={{ .chezmoi.sourceDir | quote }}

# Not a git working tree (e.g. an archive export) — nothing to wire up.
git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || exit 0

want=.githooks
have="$(git -C "$repo" config --local --get core.hooksPath || true)"

if [ "$have" != "$want" ]; then
  git -C "$repo" config --local core.hooksPath "$want"
  echo "==> git hooks: core.hooksPath -> $want (in $repo)"
fi
